{
  "schema_version": 1,
  "run_id": "cub_openai_vitb32_to_laion_vitb32_linear",
  "dataset": {
    "name": "cub",
    "fit_split": "official_train",
    "evaluation_split": "official_test",
    "attributes": 312,
    "certainty_policy": "mask_not_visible_only",
    "prompt": "a photo of a {}, a type of bird."
  },
  "source_model": {
    "kind": "open_clip",
    "name": "ViT-B-32",
    "pretrained": "openai"
  },
  "target_model": {
    "kind": "open_clip",
    "name": "ViT-B-32",
    "pretrained": "laion400m_e31"
  },
  "alignment": {
    "rotation_fit_dataset": "oxford",
    "refit_rotation_on_cub": false,
    "recompute_means_on_cub_train": true,
    "raw_rotation_ablation": false
  },
  "feature_extraction": {
    "batch_size": 128,
    "num_workers": 4,
    "encoders_frozen": true
  },
  "decoder": {
    "architecture": "linear",
    "outputs": 312,
    "seeds": [42, 43, 44, 45, 46],
    "split_seed": 2026,
    "validation_fraction": 0.2,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "batch_size": 256,
    "max_epochs": 200,
    "patience": 20,
    "pos_weight_min": 0.25,
    "pos_weight_max": 20.0,
    "min_train_positive": 20,
    "min_train_negative": 20,
    "min_test_positive": 5,
    "min_test_negative": 5,
    "bootstrap_replicates": 1000,
    "bootstrap_seed": 2026,
    "primary_metric": "macro_map"
  }
}
